{
  "name": "claude-code-nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:storybook": "test-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --build-script-name=build-storybook --only-changed",
    "check:stories": "node scripts/check-component-stories.mjs",
    "check:graph": "node scripts/check-composition-graph.mjs",
    "check:design-intent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-design-intent.mjs",
    "check:seals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-figma-seals.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:boundaries": "depcruise src",
    "check:fsd": "steiger ./src",
    "check:tokens": "eslint src/components --no-error-on-unmatched-pattern",
    "check:design-system": "npm run check:tokens && npm run check:boundaries && npm run check:graph && npm run check:design-intent && npm run check:seals && npm run check:i18n",
    "check:gates": "node scripts/check-gates.mjs",
    "check:claude": "node scripts/check-claude-infra.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:citations": "node scripts/check-adr-citations.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:spelling": "cspell --no-progress \"**/*.md\"",
    "check:audit": "npm audit --audit-level=high --omit=dev",
    "check:commits": "commitlint --from ${COMMITLINT_FROM:-origin/main} --to ${COMMITLINT_TO:-HEAD}",
    "check:debt": "node scripts/debt-scan.mjs",
    "ds:signature": "node scripts/component-signature.mjs",
    "ds:states": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/state-coverage.mjs",
    "ds:escalations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ds-escalations.mjs",
    "ds:tokens-table": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ds-token-table.mjs",
    "db:reset": "supabase db reset",
    "gen:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "gen:tokens": "node scripts/gen-tokens.mjs && prettier --write src/design-system/tokens.generated.ts src/design-system/tokens.allowlist.json src/design-system/tokens.agent-rules.md"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.78.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/nextjs-vite": "^10.4.4",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "chromatic": "^17.4.1",
    "cspell": "^10.0.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.4",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "shadcn": "^4.11.0",
    "steiger": "^0.5.13",
    "storybook": "^10.4.4",
    "supabase": "^2.106.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}

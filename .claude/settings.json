{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-protected-files.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-edit-checks.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__figma__create_new_file",
      "mcp__figma__generate_figma_design",
      "mcp__figma__use_figma",
      "mcp__figma__upload_assets",
      "mcp__figma__generate_diagram",
      "mcp__figma__add_code_connect_map",
      "mcp__figma__send_code_connect_mappings"
    ]
  }
}
